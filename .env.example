# --- Server ---
PORT=4005
# Origin allowed by CORS / Socket.IO (your frontend URL). Use * only for local testing.
CLIENT_ORIGIN=http://localhost:5173

# --- Admin ---
# Long random string used to sign admin sessions. REQUIRED in production.
ADMIN_TOKEN_SECRET=
# Optional fallback admin login (admins are normally stored in Supabase).
ADMIN_USER=
ADMIN_PASSWORD=

# --- Agora (voice) ---
AGORA_APP_ID=
# Leave empty only if your Agora project allows testing without tokens.
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRE_SECONDS=3600

# --- Supabase (rooms, chat history, admin accounts) ---
SUPABASE_URL=
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=MySpeak
SUPABASE_CHAT_TABLE=MySpeakChat
SUPABASE_ADMIN_TABLE=admin_auth

# --- Frontend (only when the frontend is hosted separately from the API) ---
# VITE_API_BASE=https://your-api.example.com
# VITE_SOCKET_URL=https://your-api.example.com
